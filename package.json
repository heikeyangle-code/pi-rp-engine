{
  "name": "pi-rp-engine",
  "version": "0.1.0",
  "description": "Universal Agentic Role-Playing & World Simulator Extension for Pi SDK (@earendil-works/pi-coding-agent)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "keywords": [
    "pi-extension",
    "pi-coding-agent",
    "roleplay",
    "sillytavern",
    "charx",
    "lorebook",
    "world-simulator"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
